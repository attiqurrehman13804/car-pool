PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/poolbus
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_PARTIAL_SECRET=change-me-partial-secret-min-32!!
ALLOWED_EMAIL_DOMAINS=university.edu,company.org
OTP_EXPIRY_MINUTES=10
CORS_ORIGIN=*
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pool Bus <noreply@poolbus.app>
MAX_PIN_ATTEMPTS=3
LOCKOUT_MINUTES=30
PASSWORD_HISTORY_COUNT=3
MATCHING_TIME_WINDOW_MINUTES=15
MATCHING_DISTANCE_METERS=500
GEOFENCE_ARRIVAL_METERS=200
ADMIN_EMAIL=admin@university.edu
